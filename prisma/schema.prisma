// Cloud Console data model.
//
// Rules this schema encodes (see docs/architecture.md):
// - Every customer row belongs to exactly one Organisation (the tenant)
//   and is read through tenantDb(), which adds the organisation filter.
// - Money is a BigInt in the currency's minor unit (thebe for BWP) with a
//   currency code beside it. Never a float.
// - Customer data is soft deleted: deletedAt marks it, purgeAfter is at
//   least 30 days later, and only the purge job removes it.
// - AuditEvent rows are never edited or deleted (enforced by a trigger).
// - Billing records (invoices, services, domains) live in the billing
//   engine, reached through the BillingAdapter. The Stub* models at the
//   end are the stand-in engine's own storage, not the console's.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Markets ─────────────────────────────────────────────────────────

enum TaxDisplay {
  /// Prices are shown with tax included.
  INCLUSIVE
  /// Prices are shown before tax, which is added on the invoice.
  EXCLUSIVE
}

/// A market decides currency, prices, catalogue, content and legal pages.
/// Everything else is the same everywhere. Edited in /admin/markets.
model Market {
  /// "bw", "za", "zw", "global". Also the public site's path.
  code      String   @id
  name      String
  /// ISO 3166-1 alpha-2 countries this market serves. Empty for the
  /// market that serves every other country.
  countries String[]
  /// ISO 4217. Data, not code: a new currency is a new row.
  currency  String
  /// BCP 47, for formatting money and dates, e.g. "en-ZA".
  locale    String
  timeZone  String
  enabled   Boolean  @default(false)
  /// Where visitors go when their market can't be told. Exactly one.
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)

  taxEnabled            Boolean    @default(false)
  /// Basis points: 1,400 is 14%.
  taxRateBps            Int        @default(0)
  taxDisplay            TaxDisplay @default(EXCLUSIVE)
  taxLabel              String     @default("VAT")
  /// Our tax registration number (e.g. VAT number), shown on invoices while tax is on.
  taxRegistrationNumber String?

  /// The company as invoices name it in this market: registration number
  /// and registered office, shown in the invoice's "From" block.
  companyRegistrationNumber String?
  registeredAddress         String?
  /// True once our own data centre (colocation) is live for this market.
  /// Until then no page says "our own data centre".
  ownDataCentre             Boolean @default(false)

  /// "card", "eft".
  paymentMethods   String[]
  eftBankName      String?
  eftAccountName   String?
  eftAccountNumber String?
  eftBranchCode    String?
  eftSwiftCode     String?

  supportEmail      String
  supportPhone      String?
  /// Plain words, e.g. "Monday to Friday, 8:00 to 17:00".
  supportHours      String
  /// Domain endings shown first, e.g. [".bw", ".co.bw"].
  highlightedTlds   String[]
  /// The data protection law named on the security page, if any.
  dataProtectionLaw String?
  /// Links to lawyer-approved legal pages by kind ("privacy", "terms",
  /// "dataProtection"). Missing kinds show the placeholder page.
  legalPages        Json     @default("{}")
  updatedAt         DateTime @updatedAt

  organisations Organisation[]
  changes       MarketChange[]
  prices        PriceBookEntry[]
  connectivityLicence ConnectivityLicence?
}

/// Every change to a market's settings, for the staff audit.
model MarketChange {
  id         String   @id @default(cuid())
  marketCode String
  userId     String
  field      String
  fromValue  String?
  toValue    String?
  createdAt  DateTime @default(now())

  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([marketCode, createdAt])
}

/// People who tried to sign up from a country we don't serve yet.
model WaitlistEntry {
  id          String    @id @default(cuid())
  name        String
  email       String
  company     String?
  /// ISO 3166-1 alpha-2.
  country     String
  phone       String?
  message     String?
  /// Set when a staff member has been in touch.
  contactedAt DateTime?
  contactedBy String?
  createdAt   DateTime  @default(now())

  @@index([country, createdAt])
}

// ─── People and organisations ────────────────────────────────────────

model Organisation {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  /// ISO 3166-1 alpha-2: the billing country given at sign-up.
  country            String    @default("BW")
  /// Decides prices, catalogue, content and legal pages. Set at sign-up
  /// from the billing country; only staff change it, with an audit event.
  billingMarket      String    @default("bw")
  /// ISO 4217, from the market at sign-up. Invoices always use it.
  currency           String    @default("BWP")
  timeZone           String    @default("Africa/Gaborone")
  /// BCP 47, from the market: how amounts and dates are written for them.
  locale             String    @default("en-BW")
  registrationNumber String?
  vatNumber          String?
  billingEmail       String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postcode           String?
  /// Put on every new invoice, for customers whose finance team needs one.
  defaultPoNumber    String?
  /// Our own test organisation: its members also see internal products.
  internal           Boolean   @default(false)
  deletedAt          DateTime?
  purgeAfter         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  market             Market                  @relation(fields: [billingMarket], references: [code], onDelete: Restrict)
  memberships        Membership[]
  invitations        Invitation[]
  billingAccount     BillingAccount?
  thebeAccount       ThebeAccount?
  accountContact     AccountContact?
  welcomeChecklist   WelcomeChecklist?
  orders             Order[]
  quotes             Quote[]
  tasks              ProvisioningTask[]
  eftPayments        EftPayment[]
  cardPayments       CardPayment[]
  invoicePoNumbers   InvoicePoNumber[]
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  conversations      AssistantConversation[]
  assistantMessages  AssistantMessage[]
  assistantActions   AssistantAction[]
  auditEvents        AuditEvent[]
  outboundEmails     OutboundEmail[]
  tenants            Tenant[]
  tenantLicences     TenantLicence[]
  tenantUsers        TenantUser[]
  domainOperations   DomainOperation[]
  backups            BackupProtection[]
  restoreRequests    BackupRestoreRequest[]
  securityProfile    SecurityProfile?
  securityReports    SecurityReport[]
  securityTenant     SecurityTenant?
  securityDevices    SecurityDevice[]
  securityIncidents  SecurityIncident[]
  socReports         SocReport[]
  licenceAssignments LicenceAssignment[]
  licenceChanges     LicenceChange[]
  tenantOnboardings  TenantOnboarding[]
  invoiceSpend       InvoiceSpend[]
  cloudSubscriptions CloudSubscription[]
  cloudUsage         CloudUsage[]
  savingTips         SavingTip[]
  cloudUsageBills    CloudUsageBill[]
  budgetAlerts       BudgetAlert[]
  serviceProfiles    ServiceProfile[]
}

enum UserKind {
  /// Someone at a customer organisation.
  CUSTOMER
  /// Fourth Generation Technologies staff. Signs in to /admin only.
  STAFF
}

model User {
  id              String       @id @default(cuid())
  kind            UserKind     @default(CUSTOMER)
  /// Stored lower-cased.
  email           String       @unique
  name            String
  /// scrypt hash; see src/server/auth/password.ts. Empty for someone who
  /// signed up with Microsoft or Google and has no password.
  passwordHash    String
  emailVerifiedAt DateTime?
  /// AES-256-GCM encrypted TOTP secret; null until the authenticator is set up.
  totpSecret      String?
  totpEnabled     Boolean      @default(false)
  /// Last accepted TOTP time step, so a code can never be used twice.
  totpLastStep    Int?
  totpEnabledAt   DateTime?
  failedAttempts  Int          @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  /// Staff only.
  staffRole       StaffRole?
  /// Staff only: what they may do in the website editor. Admins can always publish.
  websiteRole     WebsiteRole?
  /// Staff only: the business units they belong to (STRATEGY_ROLLOUT U7).
  units           BusinessUnit[] @default([])
  deactivatedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships          Membership[]
  sessions             Session[]
  identities           ExternalIdentity[]
  passkeys             Passkey[]
  recoveryCodes        RecoveryCode[]
  passwordResets       PasswordReset[]
  signInEvents         SignInEvent[]
  assignedTasks        ProvisioningTask[] @relation("taskAssignee")
  assignedIncidents    SecurityIncident[] @relation("incidentAssignee")
  completedTasks       ProvisioningTask[] @relation("taskCompletedBy")
  confirmedEft         EftPayment[]       @relation("eftConfirmedBy")
  assignedTickets      Ticket[]           @relation("ticketAssignee")
  settingsChanged      PricingChange[]
  marketChanges        MarketChange[]
  pricesApproved       PriceBookEntry[]
  presales             PresalesEngineer?
  staffInvitationsSent StaffInvitation[]  @relation("staffInvitedBy")
  staffInvitation      StaffInvitation?   @relation("staffInvitationAccepted")
  accountsLookedAfter  AccountContact[]   @relation("accountContact")
  contactCard          StaffContactCard?
}

/// An invitation for a colleague to set up their own staff account.
model StaffInvitation {
  id          String       @id @default(cuid())
  /// Stored lower-cased.
  email       String
  staffRole   StaffRole
  websiteRole WebsiteRole?
  /// Hash of the newest emailed link; null once used or withdrawn.
  tokenHash   String?      @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  /// The account made when it was accepted.
  userId      String?      @unique
  /// When they finished setting up (password and authenticator) and the inviter was told.
  readyAt     DateTime?
  createdAt   DateTime     @default(now())

  invitedBy User  @relation("staffInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  user      User? @relation("staffInvitationAccepted", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
}

enum WebsiteRole {
  /// Drafts website changes.
  EDITOR
  /// Drafts, publishes, schedules, restores and approves legal text.
  PUBLISHER
}

enum StaffRole {
  /// Answers tickets and reads customer accounts.
  SUPPORT
  /// Works the provisioning queue.
  PROVISIONING
  /// Confirms payments and sees billing.
  FINANCE
  /// Everything, including margins, the currency buffer and staff accounts.
  ADMIN
}

enum SessionStage {
  /// Password accepted; waiting for the authenticator code.
  CODE_PENDING
  /// Signed in without an authenticator; must set one up before anything else.
  SETUP_PENDING
  /// Fully signed in.
  ACTIVE
}

/// A browser session. Only the SHA-256 hash of the cookie value is stored.
model Session {
  id                   String       @id @default(cuid())
  tokenHash            String       @unique
  userId               String
  /// Mirrors the user's kind, so a customer cookie can never open /admin.
  audience             UserKind
  stage                SessionStage
  activeOrganisationId String?
  expiresAt            DateTime
  lastSeenAt           DateTime     @default(now())
  revokedAt            DateTime?
  /// When this session last passed a passkey or authenticator check. Paying,
  /// managing people and changing security settings need one in the last 15 minutes.
  stepUpAt             DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum IdentityProvider {
  MICROSOFT
  GOOGLE
}

/// A Microsoft or Google account someone signs in with. Linked by verified
/// email only after they confirm with their current sign-in.
model ExternalIdentity {
  id         String           @id @default(cuid())
  userId     String
  provider   IdentityProvider
  /// The provider's stable id for the account: Microsoft's tenant and object
  /// id ("tid:oid"), Google's "sub".
  subject    String
  email      String
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

/// A passkey (WebAuthn credential): fingerprint, face or device PIN.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  /// Synced across the person's devices (e.g. iCloud Keychain, Google Password Manager).
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use backup codes for when the phone is lost. Stored hashed.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A "forgot password" request. The link's token is made when the email is
/// sent and only its SHA-256 hash is kept; it works once, for 30 minutes.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SignInOutcome {
  SUCCEEDED
  WRONG_PASSWORD
  WRONG_CODE
  LOCKED
}

/// One sign-in attempt for a known account. Shown on the Security page.
model SignInEvent {
  id        String        @id @default(cuid())
  userId    String
  outcome   SignInOutcome
  /// "authenticator", "recovery code", or null when the password failed.
  method    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Role {
  /// Everything, including the team and closing the account.
  OWNER
  /// Orders, changes services and manages the team, but not owners.
  ADMIN
  /// Invoices, payments and statements. Nothing else changes.
  BILLING
  /// Sees everything, changes nothing.
  READ_ONLY
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           Role
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations Invitation[] @relation("invitedBy")

  @@unique([organisationId, userId])
  @@index([userId])
}

/// An emailed invitation. Only the hash of the link's token is stored.
model Invitation {
  id             String    @id @default(cuid())
  organisationId String
  email          String
  role           Role
  tokenHash      String?   @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invitedBy    Membership   @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organisationId])
}

// ─── Audit ───────────────────────────────────────────────────────────

enum ActorKind {
  CUSTOMER
  STAFF
  SYSTEM
  ASSISTANT
}

/// What happened to an organisation's account, by whom. Every staff
/// action on a customer account is visible to that customer.
model AuditEvent {
  id                String    @id @default(cuid())
  organisationId    String
  actorKind         ActorKind
  actorUserId       String?
  /// The name at the time, so the log still reads well if the person leaves.
  actorLabel        String
  action            String
  targetType        String?
  targetId          String?
  /// Plain-language line shown to the customer.
  summary           String
  data              Json?
  visibleToCustomer Boolean   @default(true)
  ipAddress         String?
  createdAt         DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt])
}

/// Staff actions that don't belong to one customer (settings, staff accounts).
model StaffAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String
  actorLabel  String
  action      String
  summary     String
  data        Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── Email ───────────────────────────────────────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Every email the console sends, queued in the same transaction as the
/// change that caused it and sent by a background job. The message is
/// written at send time from kind and payload, so links with secrets in
/// them (invitations) are never stored.
model OutboundEmail {
  id             String      @id @default(cuid())
  organisationId String?
  kind           String
  toAddress      String
  payload        Json
  /// Filled in once sent, for the record.
  subject        String?
  status         EmailStatus @default(QUEUED)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

// ─── Rate limiting ───────────────────────────────────────────────────

/// Fixed-window counters, e.g. sign-in attempts per IP per minute.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ─── Billing link ────────────────────────────────────────────────────

enum BillingProvider {
  STUB
  WHMCS
}

/// One console organisation is one client in the billing engine.
model BillingAccount {
  id               String          @id @default(cuid())
  organisationId   String          @unique
  provider         BillingProvider
  externalClientId String
  createdAt        DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([provider, externalClientId])
}

/// What the price sync made in WHMCS for each console item, so a rename
/// updates the same WHMCS product instead of making another.
model WhmcsLink {
  /// "group" (a product category) or "product".
  kind      String
  /// The category key or product slug.
  key       String
  whmcsId   String
  updatedAt DateTime @updatedAt

  @@id([kind, key])
  @@unique([kind, whmcsId])
}

/// A purchase order number the customer put on one invoice, kept in the
/// console. See docs/whmcs-mapping.md for why it lives here.
model InvoicePoNumber {
  id             String   @id @default(cuid())
  organisationId String
  invoiceId      String
  poNumber       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, invoiceId])
}

// ─── Catalogue and pricing ───────────────────────────────────────────

enum ConnectorFamily {
  PRODUCTIVITY
  PUBLIC_CLOUD
  SERVERS
  WEB_AND_DOMAINS
  PROTECTION
  OUR_SOFTWARE
  SERVICES
  CONNECTIVITY
}

/// Where a family, or a product, can be seen. Draft is hidden everywhere
/// but the staff catalogue; internal shows to staff and to our own test
/// organisations, so they can order it; live is on sale.
enum CatalogueStatus {
  DRAFT
  INTERNAL
  LIVE
}

/// How an order for a product is carried out.
enum Fulfilment {
  /// By the family's connector, with no one involved.
  AUTOMATIC
  /// A task for our staff.
  MANUAL
  /// The customer asks for a quote instead of ordering.
  QUOTE
}

/// A group of categories fulfilled by one connector, e.g. Productivity.
model ProductFamily {
  key         String          @id
  name        String
  description String
  /// The connector that fulfils its products.
  connector   ConnectorFamily
  /// A draft or internal family hides its products at least as much.
  status      CatalogueStatus @default(DRAFT)
  /// When set, every product in the family is sold this way (Connectivity: by quote).
  fulfilment  Fulfilment?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  categories ProductCategory[]
}

model ProductCategory {
  key         String @id
  name        String
  description String
  familyKey   String
  /// Margin on cost in basis points (10,000 = 100%). Set in the admin console.
  marginBps   Int
  sortOrder   Int    @default(0)

  family   ProductFamily @relation(fields: [familyKey], references: [key], onDelete: Restrict)
  products Product[]
}

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  categoryKey        String
  name               String
  summary            String
  includes           String[]
  excludes           String[]
  /// "per user", "per server", "per site", "per domain".
  unitLabel          String
  /// Whether the customer chooses a quantity (seats) or buys one.
  quantityAllowed    Boolean         @default(false)
  minQuantity        Int             @default(1)
  /// What it costs us each month, in costCurrency, in minor units.
  costMinor          BigInt
  costCurrency       String
  /// Fixed customer price instead of cost plus margin (e.g. our own services).
  fixedPriceMinor    BigInt?
  fixedPriceCurrency String?
  /// How long setup takes when done by hand. Shown as "expected by".
  setupHours         Int
  /// The shortest commitment in months; 1 is month to month.
  minTermMonths      Int             @default(1)
  /// Plain words on commitment, shown before ordering, e.g. annual terms.
  commitmentNote     String?
  /// The product's id in the billing engine. Empty until the product is
  /// first sent to billing (the WHMCS product sync fills it in).
  billingProductId   String?
  /// Options the customer picks when ordering, e.g. operating system.
  options            Json?
  status             CatalogueStatus @default(DRAFT)
  fulfilment         Fulfilment      @default(MANUAL)
  /// Market codes it is offered in. Local data copy is "bw" only, because
  /// the copy is kept in Botswana.
  markets            String[]
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  category   ProductCategory    @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  orders     Order[]
  quotes     Quote[]
  launchKit  LaunchKit?
  inclusions ProductInclusion[] @relation("planIncludes")
  includedIn ProductInclusion[] @relation("includedIn")
}

/// A product included in a plan at no extra charge (STRATEGY_ROLLOUT U3):
/// email security and backup in every Microsoft 365, Google Workspace and
/// hosting plan. Set in the staff catalogue. The included product keeps its
/// own cost, so the plan's true cost is its own plus what it includes.
model ProductInclusion {
  planId     String
  includedId String
  /// How many of the included product come with each unit of the plan (per user, per server).
  quantity   Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  plan     Product @relation("planIncludes", fields: [planId], references: [id], onDelete: Cascade)
  included Product @relation("includedIn", fields: [includedId], references: [id], onDelete: Restrict)

  @@id([planId, includedId])
}

/// A domain ending we sell, with what the registrar charges us.
model Tld {
  /// ".co.za"
  tld               String    @id
  costRegisterMinor BigInt
  costRenewMinor    BigInt
  costCurrency      String
  /// Where the cost came from: null when typed or seeded, "openprovider" when synced.
  costSource        String?
  costSyncedAt      DateTime?
  /// Market codes it is offered in.
  markets           String[]
  sortOrder         Int       @default(0)
}

/// Single row: settings that apply to every product.
model PricingSettings {
  id                String    @id @default("global")
  /// Added to the exchange rate for products we pay for in another currency.
  currencyBufferBps Int
  /// The monthly price book is approved on its own when no price moves by more than this.
  autoApproveBps    Int       @default(300)
  /// The plan margin report warns about any plan whose margin is below this (STRATEGY_ROLLOUT U3).
  marginFloorBps    Int       @default(1500)
  /// When the Bank of Botswana rates were last fetched, and why the last try failed.
  ratesCheckedAt    DateTime?
  ratesError        String?
  updatedAt         DateTime  @updatedAt
}

/// The rate used to price from a day ("2026-10-12") or, before
/// fortnightly pricing, a month ("2026-09"). Rate is quote per base, times 1,000,000.
model FxRate {
  id         String    @id @default(cuid())
  /// The day or month it applies from; the two sort together.
  month      String
  base       String
  quote      String
  rateMicros BigInt
  setById    String?
  /// "bob" when worked out from a Bank of Botswana table; null when typed or seeded.
  source     String?
  /// The publication date of that table.
  sourceDate DateTime? @db.Date
  createdAt  DateTime  @default(now())

  @@unique([month, base, quote])
}

/// One day's Bank of Botswana reference rates, as published.
model OfficialRateTable {
  id           String         @id @default(cuid())
  /// The day Bank of Botswana published it.
  publishedOn  DateTime       @unique @db.Date
  /// Where it was fetched from, e.g. "allratestoday".
  source       String
  fetchedAt    DateTime       @default(now())
  /// Why it isn't used, e.g. a jump too large to trust. Null when it is.
  heldBack     String?
  /// Staff who accepted a held-back table.
  acceptedById String?
  rates        OfficialRate[]
  runs         PriceBookRun[]
}

/// A rate as published: 1 base in quote, e.g. 1 BWP = "0.0742" USD. The
/// value is kept as the decimal text published, never as a float.
model OfficialRate {
  id      String @id @default(cuid())
  tableId String
  base    String
  quote   String
  value   String

  table OfficialRateTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, base, quote])
}

enum PriceBookRunStatus {
  /// Every suggestion matched the prices already in effect.
  NO_CHANGES
  /// Waiting for an Admin: a price moves by more than the threshold.
  AWAITING_APPROVAL
  /// In effect, approved automatically or by an Admin.
  APPLIED
}

/// The price book for a 14-day period, worked out on its first day (a
/// Monday) from the Bank of Botswana rates and the buffer, and what
/// happened to it. Prices change every 14 days; quotes hold for 14 days.
model PriceBookRun {
  id             String             @id @default(cuid())
  /// The day it starts, "2026-10-12".
  period         String             @unique
  status         PriceBookRunStatus
  tableId        String
  /// The month's rates: [{ base, quote, rateMicros }].
  rates          Json
  /// Each price that changes: market, item, name, currency, from and to (minor units, as text) and the change in basis points.
  changes        Json
  maxChangeBps   Int
  thresholdBps   Int
  /// Null when it was approved automatically.
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  /// When WHMCS got the new prices, or why it hasn't yet.
  syncedAt       DateTime?
  syncError      String?
  createdAt      DateTime           @default(now())

  table   OfficialRateTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  entries PriceBookEntry[]
}

/// An email to Admins about rates or pricing, sent once per key
/// (e.g. "drift:2026-10-12:USD/BWP").
model PricingAlert {
  key    String   @id
  sentAt DateTime @default(now())
}

/// A market's price book: the prices staff approved, each from a month
/// until a later entry replaces it. Suggestions (from cost, rate, buffer
/// and margin) are worked out live and are never shown to customers.
model PriceBookEntry {
  id             String   @id @default(cuid())
  marketCode     String
  /// "product:<slug>" or "tld:<ending>", e.g. "tld:.co.za".
  item           String
  /// The first day it applies, "2026-10-12", or month for entries from
  /// before fortnightly pricing, "2026-10". The two sort together.
  month          String
  currency       String
  /// A product's price per unit per month, or a domain's yearly
  /// registration price.
  amountMinor    BigInt
  /// A domain's yearly renewal price.
  renewMinor     BigInt?
  /// What the suggestion was when it was approved, and how it was worked out.
  suggestedMinor BigInt?
  breakdown      Json?
  /// Null for prices carried over from Phase 1 or seeded for development.
  approvedById   String?
  approvedAt     DateTime @default(now())
  /// The price book it came from, when it came from one.
  runId          String?

  market     Market        @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  approvedBy User?         @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  run        PriceBookRun? @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([marketCode, item, month])
}

/// Every change to margins, the buffer or rates, for the staff audit.
model PricingChange {
  id        String   @id @default(cuid())
  userId    String
  field     String
  fromValue String?
  toValue   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ─── Orders and provisioning ─────────────────────────────────────────

enum OrderStatus {
  /// Accepted; staff or a connector is setting it up.
  SETTING_UP
  ACTIVE
  CANCELLED
  FAILED
}

model Order {
  id                String      @id @default(cuid())
  /// Short reference customers and staff quote, e.g. "ORD-7K2M".
  reference         String      @unique
  organisationId    String
  productId         String
  quantity          Int
  options           Json?
  /// Price per unit per month when ordered.
  unitPriceMinor    BigInt
  currency          String
  monthlyTotalMinor BigInt
  status            OrderStatus @default(SETTING_UP)
  expectedBy        DateTime
  placedById        String
  billingOrderId    String?
  billingServiceIds String[]
  billingInvoiceId  String?
  /// When changing seats on an existing service.
  changesServiceId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  tasks        ProvisioningTask[]

  @@index([organisationId, createdAt])
}

enum QuoteStatus {
  /// A request staff haven't priced yet.
  NEW
  /// Priced and emailed. Past its validity date it can't be accepted.
  SENT
  ACCEPTED
  DECLINED
  /// Staff closed it without a sale, e.g. a duplicate or spam.
  CLOSED
}

enum QuoteLineKind {
  MONTHLY
  ONE_OFF
}

/// A request for a quote, from the public site or the console, and the
/// quote staff write for it. Anyone can ask; accepting needs an account
/// and places an ordinary order at the quoted price.
model Quote {
  id             String      @id @default(cuid())
  /// Short reference people can read out, e.g. "QUO-7K2M9Q".
  reference      String      @unique
  status         QuoteStatus @default(NEW)
  /// Set when asked from the console, or when the quote is opened from its
  /// link and taken into an account.
  organisationId String?
  requestedById  String?
  name           String
  company        String?
  email          String
  phone          String?
  /// ISO 3166-1 alpha-2.
  country        String
  need           String
  /// The market it is priced in; its currency is the quote's currency.
  market         String
  /// The product asked about, and the one the order is placed for.
  productId      String?
  /// A partner who carries out this kind of work instead of us, e.g.
  /// "NSMC" for enterprise, on-site compliance projects. Staff introduce
  /// the customer and close the request.
  referTo        String?
  referredAt     DateTime?
  /// Plain words to the customer, shown above the lines.
  message        String?
  /// The last day it can be accepted, in the market's time zone.
  validUntil     DateTime?   @db.Date
  /// Only the newest emailed link works; made when the email is sent.
  tokenHash      String?     @unique
  sentAt         DateTime?
  sentByName     String?
  decidedAt      DateTime?
  decidedByName  String?
  declineReason  String?
  orderId        String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines        QuoteLine[]
  connectivity ConnectivityRequest?

  @@index([status, createdAt])
  @@index([organisationId, createdAt])
}

model QuoteLine {
  id             String        @id @default(cuid())
  quoteId        String
  kind           QuoteLineKind
  description    String
  quantity       Int           @default(1)
  unitPriceMinor BigInt
  sortOrder      Int           @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Work for staff, made by a connector that can't do the job itself yet.
model ProvisioningTask {
  id               String          @id @default(cuid())
  organisationId   String
  orderId          String?
  family           ConnectorFamily
  /// "provision", "change_quantity", "cancel".
  kind             String
  title            String
  /// What staff need to do, in steps.
  instructions     String
  status           TaskStatus      @default(OPEN)
  expectedBy       DateTime
  /// The service in the billing engine, for work on one already running (hosted elsewhere).
  billingServiceId String?
  /// The last reminder sent about it being late.
  remindedAt       DateTime?
  assigneeId       String?
  notes            String?
  completedById    String?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignee       User?           @relation("taskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedBy    User?           @relation("taskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  licenceChanges LicenceChange[]

  @@index([status, expectedBy])
  @@index([organisationId])
}

// ─── Users and licences ─────────────────────────────────────────────

enum TenantVendor {
  MICROSOFT
  GOOGLE
}

/// Admin access to a customer's tenant (STRATEGY_ROLLOUT U6).
enum TenantConsent {
  NONE
  REQUESTED
  GRANTED
}

/// A customer's Microsoft 365 or Google Workspace tenant, as we manage it.
/// Until the vendor's API is connected, staff keep it in step with the
/// partner portal and every change goes through a task.
model Tenant {
  id             String       @id @default(cuid())
  organisationId String
  vendor         TenantVendor
  /// The domain people sign in with, e.g. kgalehill.co.bw.
  primaryDomain  String
  /// The vendor's own id for the tenant, once known.
  vendorTenantId String?
  /// When users and licences were last read from the vendor or checked by staff.
  lastSyncedAt   DateTime?
  /// Admin access the customer gave us (Microsoft delegated admin, Google reseller access), STRATEGY_ROLLOUT U6.
  consent            TenantConsent @default(NONE)
  /// The link the customer accepts it with.
  consentLink        String?
  consentRequestedAt DateTime?
  consentGrantedAt   DateTime?
  /// The tenant's security settings from the vendor, once access is given: [{ key, title, ok }].
  securityChecks     Json?
  securityCheckedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  licences     TenantLicence[]
  users        TenantUser[]
  changes      LicenceChange[]
  onboarding   TenantOnboarding?

  @@unique([organisationId, vendor])
}

enum OnboardingKind {
  /// A tenant we set up from nothing.
  NEW
  /// The customer's existing subscription, brought across from another provider.
  TRANSFER
}

/// Getting a tenant ready: the DNS records the customer adds, the email
/// move they book, and for a transfer, the checklist. Finished by staff.
model TenantOnboarding {
  id                String         @id @default(cuid())
  organisationId    String
  tenantId          String         @unique
  kind              OnboardingKind
  /// The vendor's domain verification value, e.g. MS=ms48213377, from the partner portal.
  verificationValue String?
  domainVerifiedAt  DateTime?
  dnsCheckedAt      DateTime?
  /// The last check, record by record.
  dnsResults        Json?
  /// For a transfer: the vendor's link for accepting us as partner.
  partnerInviteUrl  String?
  /// Where their email is now, e.g. "Google Workspace" or "Our web host".
  migrationSource   String?
  migrationStartsAt DateTime?
  migrationNotes    String?
  migrationTaskId   String?
  /// Checklist items done, by key: { at, by }.
  checklist         Json           @default("{}")
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// A kind of licence the tenant holds, and how many were bought.
model TenantLicence {
  id             String   @id @default(cuid())
  organisationId String
  tenantId       String
  /// The vendor's SKU, e.g. O365_BUSINESS_PREMIUM.
  sku            String
  name           String
  /// How many the customer pays for.
  purchased      Int
  /// How many the vendor says the tenant has, from the daily sync (U6).
  vendorQuantity  Int?
  vendorCheckedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments  LicenceAssignment[]
  changes      LicenceChange[]

  @@unique([tenantId, sku])
  @@index([organisationId])
}

/// A person in the tenant: someone with a mailbox or sign-in there. Not the
/// same as a console team member.
model TenantUser {
  id             String    @id @default(cuid())
  organisationId String
  tenantId       String
  email          String
  name           String
  /// False when sign-in is blocked in the tenant.
  enabled        Boolean   @default(true)
  lastSignInAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments  LicenceAssignment[]
  changes      LicenceChange[]

  @@unique([tenantId, email])
  @@index([organisationId])
}

model LicenceAssignment {
  id             String   @id @default(cuid())
  organisationId String
  tenantUserId   String
  licenceId      String
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         TenantUser    @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  licence      TenantLicence @relation(fields: [licenceId], references: [id], onDelete: Cascade)

  @@unique([tenantUserId, licenceId])
  @@index([organisationId])
}

enum LicenceChangeKind {
  /// Give a user a licence.
  ASSIGN
  /// Take a licence back, freeing it for someone else.
  UNASSIGN
  /// Create a new person in the tenant, with a licence when one is named.
  ADD_USER
  /// Block sign-in and free the person's licences.
  REMOVE_USER
}

enum LicenceChangeStatus {
  PENDING
  DONE
  CANCELLED
}

/// A change a customer asked for in their tenant. Applied at once when the
/// vendor's API is connected; otherwise pending until staff finish its task.
model LicenceChange {
  id             String              @id @default(cuid())
  organisationId String
  tenantId       String
  kind           LicenceChangeKind
  status         LicenceChangeStatus @default(PENDING)
  tenantUserId   String?
  licenceId      String?
  /// For ADD_USER: the new person.
  email          String?
  name           String?
  taskId         String?
  requestedById  String
  /// Sent to the vendor's API (U6): attempts and the last refusal. Staff do it by hand when it fails.
  vendorAttempts Int                 @default(0)
  vendorError    String?
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         TenantUser?       @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  licence      TenantLicence?    @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  task         ProvisioningTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([taskId])
}

// ─── Payments ────────────────────────────────────────────────────────

enum EftStatus {
  /// The customer says they paid; staff haven't seen it in the bank yet.
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
}

model EftPayment {
  id             String    @id @default(cuid())
  organisationId String
  invoiceId      String
  amountMinor    BigInt
  currency       String
  /// The reference the customer used, which should be the invoice number.
  reference      String
  paidOn         DateTime  @db.Date
  status         EftStatus @default(AWAITING_CONFIRMATION)
  reportedById   String
  confirmedById  String?
  decidedAt      DateTime?
  staffNote      String?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  confirmedBy  User?        @relation("eftConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([organisationId])
}

enum CardPaymentStatus {
  STARTED
  SUCCEEDED
  FAILED
}

/// A card payment through the payment adapter.
model CardPayment {
  id             String            @id @default(cuid())
  organisationId String
  invoiceId      String
  amountMinor    BigInt
  currency       String
  gateway        String
  gatewayRef     String            @unique
  status         CardPaymentStatus @default(STARTED)
  startedById    String
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
}

// ─── Support ─────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
}

/// How urgent a ticket is; response targets are per unit and priority (U7).
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id             String       @id @default(cuid())
  reference      String       @unique
  organisationId String
  subject        String
  status         TicketStatus @default(OPEN)
  openedById     String
  assigneeId     String?
  /// Set when the assistant handed over; the conversation is attached.
  conversationId String?      @unique
  /// Routing and measurement (STRATEGY_ROLLOUT U7).
  priority        TicketPriority @default(NORMAL)
  unit            BusinessUnit   @default(SUPPORT)
  /// Our first reply the customer can see.
  firstResponseAt DateTime?
  /// When it was last resolved; cleared if it reopens.
  resolvedAt      DateTime?
  /// The one-question satisfaction rating, 1 to 5, after it is resolved.
  rating          Int?
  ratingComment   String?
  ratedAt         DateTime?
  ratingToken     String?        @unique
  deletedAt      DateTime?
  purgeAfter     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignee     User?                  @relation("ticketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  messages     TicketMessage[]

  @@index([organisationId, updatedAt])
  @@index([status, updatedAt])
}

enum MessageAuthor {
  CUSTOMER
  STAFF
  ASSISTANT
  SYSTEM
}

model TicketMessage {
  id             String        @id @default(cuid())
  organisationId String
  ticketId       String
  authorKind     MessageAuthor
  authorUserId   String?
  authorLabel    String
  body           String
  /// Staff-only notes are hidden from the customer.
  internal       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model AssistantConversation {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  title          String?
  handedOverAt   DateTime?
  deletedAt      DateTime?
  purgeAfter     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  messages     AssistantMessage[]
  actions      AssistantAction[]
  ticket       Ticket?

  @@index([organisationId, userId, updatedAt])
}

enum AssistantRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id             String        @id @default(cuid())
  organisationId String
  conversationId String
  role           AssistantRole
  /// What the person sees.
  text           String
  /// Tool calls and results in this turn, for the handover and the audit.
  toolTrace      Json?
  createdAt      DateTime      @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

enum AssistantActionStatus {
  PROPOSED
  CONFIRMED
  DECLINED
  EXPIRED
}

/// Something the assistant suggests doing. Nothing happens until the
/// customer presses Confirm.
model AssistantAction {
  id             String                @id @default(cuid())
  organisationId String
  conversationId String
  kind           String
  /// Plain words shown on the confirm card.
  summary        String
  input          Json
  status         AssistantActionStatus @default(PROPOSED)
  decidedById    String?
  decidedAt      DateTime?
  result         Json?
  createdAt      DateTime              @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId])
}

// ─── Stand-in billing engine ─────────────────────────────────────────
// Storage for StubBillingAdapter only. Shaped like the WHMCS records it
// stands in for, so behaviour matches; the console never reads these
// tables directly. Removed once WHMCS is live.

model StubClient {
  id          Int      @id @default(autoincrement())
  companyName String
  email       String
  firstName   String
  lastName    String
  country     String
  currency    String
  address1    String?
  city        String?
  phone       String?
  taxId       String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())

  services     StubService[]
  invoices     StubInvoice[]
  transactions StubTransaction[]
  payMethods   StubPayMethod[]
  domains      StubDomain[]
  orders       StubOrder[]
}

model StubProduct {
  id        Int     @id @default(autoincrement())
  gid       Int
  groupName String
  name      String
  type      String
  /// { "BWP": { "monthly": "12500" } } in minor units.
  pricing   Json
  hidden    Boolean @default(false)
}

model StubOrder {
  id        Int      @id @default(autoincrement())
  clientId  Int
  status    String
  invoiceId Int?
  items     Json
  createdAt DateTime @default(now())

  client StubClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model StubService {
  id             Int      @id @default(autoincrement())
  clientId       Int
  productId      Int
  orderId        Int?
  name           String
  groupName      String
  domain         String?
  /// Pending, Active, Suspended, Terminated, Cancelled.
  status         String
  quantity       Int      @default(1)
  recurringMinor BigInt
  currency       String
  billingCycle   String   @default("Monthly")
  regDate        DateTime @db.Date
  nextDueDate    DateTime @db.Date
  /// Users, resources and usage, as a provisioning module would report them.
  details        Json?
  suspendReason  String?

  client StubClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model StubInvoice {
  id         Int       @id @default(autoincrement())
  clientId   Int
  /// WHMCS invoice number, e.g. "INV-2026-0142".
  invoiceNum String    @unique
  date       DateTime  @db.Date
  dueDate    DateTime  @db.Date
  datePaid   DateTime?
  /// Draft, Unpaid, Paid, Cancelled, Refunded, Collections, Payment Pending.
  status     String
  currency   String
  subtotal   BigInt
  taxRateBps Int       @default(0)
  tax        BigInt    @default(0)
  total      BigInt
  notes      String?

  client StubClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  StubInvoiceItem[]

  @@index([clientId, date])
}

model StubInvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  /// Hosting, Domain, Setup, ProRata, Item, Upgrade.
  type        String
  relId       Int?
  description String
  amount      BigInt
  taxed       Boolean @default(true)

  invoice StubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model StubTransaction {
  id          Int      @id @default(autoincrement())
  clientId    Int
  invoiceId   Int?
  date        DateTime
  gateway     String
  transId     String
  amountIn    BigInt
  amountOut   BigInt   @default(0)
  currency    String
  description String

  client StubClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

model StubPayMethod {
  id          Int     @id @default(autoincrement())
  clientId    Int
  /// "CreditCard" or "BankAccount".
  type        String
  description String
  cardType    String?
  lastFour    String?
  expiryDate  String?
  isDefault   Boolean @default(false)

  client StubClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model StubDomain {
  id                Int      @id @default(autoincrement())
  clientId          Int
  domain            String   @unique
  registrar         String
  status            String
  regDate           DateTime @db.Date
  expiryDate        DateTime @db.Date
  nextDueDate       DateTime @db.Date
  recurringMinor    BigInt
  currency          String
  autoRenew         Boolean  @default(true)
  registrationYears Int      @default(1)

  client StubClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Tax rules, as WHMCS keeps them (Setup > Payments > Tax Configuration):
/// a rate per client country, "*" for every other country. The console
/// writes these from market settings; on WHMCS they are set up to match.
model StubTaxRule {
  country String @id
  rateBps Int
  label   String
}

model StubTldPrice {
  tld        String   @id
  currency   String
  register   BigInt
  renew      BigInt
  transfer   BigInt
  /// Names ending in this TLD that the stub treats as taken.
  takenNames String[]
}

/// Stub card gateway only: what the pretend card company knows about a charge.
model StubCardCharge {
  id          String   @id
  amountMinor BigInt
  currency    String
  description String
  returnUrl   String
  /// "pending", "succeeded" or "declined".
  status      String   @default("pending")
  lastFour    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An invoice's charges grouped by what they were for, kept so the spend
/// views don't read every invoice from billing on each visit. Read again
/// when the invoice's status or total changes.
model InvoiceSpend {
  id             String   @id @default(cuid())
  organisationId String
  invoiceId      String
  /// First day of the month the invoice was issued in.
  month          DateTime @db.Date
  status         String
  totalMinor     BigInt
  currency       String
  /// [{ category, label, amountMinor }], before VAT. amountMinor is a string.
  lines          Json
  readAt         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, invoiceId])
  @@index([organisationId, month])
}

enum CloudVendor {
  AZURE
}

/// A customer's Azure subscription, which usage files are matched to.
model CloudSubscription {
  id             String      @id @default(cuid())
  organisationId String
  vendor         CloudVendor @default(AZURE)
  /// Azure's subscription id (a GUID), stored lower-cased. One customer each.
  subscriptionId String      @unique
  name           String
  /// Our margin on usage, in basis points: 1,500 is 15%.
  marginBps      Int
  /// The customer's monthly budget for this subscription's usage, in their currency.
  budgetMinor    BigInt?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  usage        CloudUsage[]
  bills        CloudUsageBill[]
  budgetAlerts BudgetAlert[]

  @@index([organisationId])
}

/// One resource's usage on one day for one kind of meter, from an imported
/// usage file. Re-importing a day replaces it.
model CloudUsage {
  id             String   @id @default(cuid())
  organisationId String
  subscriptionId String
  day            DateTime @db.Date
  resourceGroup  String
  /// The resource's name, the last part of its id.
  resource       String
  /// e.g. "Microsoft.Compute/virtualMachines", or "" when the file has none.
  resourceType   String
  /// Azure's meter category, e.g. "Virtual Machines" or "Storage".
  category       String
  /// What it cost us, in the file's currency.
  costMinor      BigInt
  costCurrency   String
  /// What the customer pays: cost plus margin, in their currency.
  priceMinor     BigInt
  currency       String
  importId       String

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  subscription CloudSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  import       CloudUsageImport  @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, day, resourceGroup, resource, category])
  @@index([organisationId, day])
}

/// A usage file staff uploaded. One file can cover many customers.
model CloudUsageImport {
  id           String    @id @default(cuid())
  fileName     String
  rowsRead     Int
  rowsImported Int
  firstDay     DateTime? @db.Date
  lastDay      DateTime? @db.Date
  /// Subscriptions in the file that no customer has, and other notes.
  notes        Json      @default("[]")
  importedById String
  createdAt    DateTime  @default(now())

  usage CloudUsage[]
}

enum SavingSource {
  /// Found by the console, e.g. servers switched off whose disks still cost money.
  AUTO
  /// Added by staff, e.g. from Azure Advisor.
  STAFF
}

enum SavingStatus {
  OPEN
  /// The customer asked us to make the change; a staff task is open.
  ASKED
  DONE
  DISMISSED
}

/// A way the customer could spend less, with what it would save a month.
model SavingTip {
  id             String       @id @default(cuid())
  organisationId String
  /// Found tips are keyed by what they are about, so a new import updates
  /// the same tip instead of adding another.
  key            String
  source         SavingSource
  title          String
  detail         String
  monthlyMinor   BigInt
  currency       String
  status         SavingStatus @default(OPEN)
  taskId         String?
  createdById    String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, key])
}

/// A month of a subscription's usage, put on an invoice. One per month,
/// so usage is never billed twice.
model CloudUsageBill {
  id             String   @id @default(cuid())
  organisationId String
  subscriptionId String
  /// First day of the month billed.
  month          DateTime @db.Date
  /// Empty while the invoice is being raised.
  invoiceId      String?
  amountMinor    BigInt
  currency       String
  billedById     String
  createdAt      DateTime @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  subscription CloudSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, month])
  @@index([organisationId])
}

/// A budget warning sent for a subscription's month, so each is sent once.
model BudgetAlert {
  id             String   @id @default(cuid())
  organisationId String
  subscriptionId String
  month          DateTime @db.Date
  /// "forecast" (on course to go over), "80" or "100" (per cent of the budget used).
  level          String
  sentAt         DateTime @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  subscription CloudSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, month, level])
  @@index([organisationId])
}

// ─── Service status and newsletter (Milestone 3) ──────────────────────

enum IncidentImpact {
  /// Working, but slower or partly unavailable.
  DEGRADED
  /// Not working.
  OUTAGE
  /// Planned work.
  MAINTENANCE
}

/// Something wrong (or planned) with our services, shown in the site's status strip while open.
model Incident {
  id         String         @id @default(cuid())
  title      String
  impact     IncidentImpact
  /// Plain words for customers: what is affected and what we are doing.
  message    String?
  startedAt  DateTime       @default(now())
  resolvedAt DateTime?
  /// "system" when opened by the console's own checks.
  openedBy   String
  resolvedBy String?
  /// Set on incidents the console's own checks open, e.g. "check:billing", so they resolve themselves.
  checkKey   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([resolvedAt, startedAt])
  @@index([checkKey, resolvedAt])
}

/// Someone who asked for the monthly insights email. Receives it only once confirmed (double opt-in).
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  /// The market they signed up from, for the right edition.
  marketCode       String
  /// The words they agreed to, as shown.
  consentText      String
  consentAt        DateTime
  ipAddress        String?
  /// SHA-256 of the link in the confirmation email; cleared once used.
  confirmTokenHash String?   @unique
  confirmSentAt    DateTime?
  confirmedAt      DateTime?
  /// The one-click unsubscribe link's token (stays valid for good).
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([confirmedAt, unsubscribedAt])
}

// ─── Thapelo, the sales assistant on the public site ─────────────────
// docs/FINAL_BUILD.md, Milestone 6. Visitors aren't signed in: a chat is
// found by a random token kept in the visitor's cookie (only its hash is
// stored). Chats and leads are deleted on the schedule in the Privacy
// Notice (purgeAfter).

model SalesChat {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  market       String
  /// The page the chat started on, e.g. /bw/pricing.
  startedOn    String?
  handedOverAt DateTime?
  purgeAfter   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages SalesChatMessage[]
  lead     Lead?

  @@index([purgeAfter])
}

model SalesChatMessage {
  id        String        @id @default(cuid())
  chatId    String
  role      AssistantRole
  text      String
  /// What Thapelo looked up in this turn, for staff reading the lead.
  toolTrace Json?
  createdAt DateTime      @default(now())

  chat SalesChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum LeadSource {
  /// The visitor left their details for follow-up.
  ASSISTANT
  /// The visitor pressed "Talk to a person".
  PERSON
  /// A quote request from the public site.
  QUOTE
  /// A confirmed newsletter sign-up.
  NEWSLETTER
  /// The free email security check.
  EMAIL_CHECK
  /// The Microsoft 365 and Google Workspace cost calculator.
  COST_CALCULATOR
  /// The Data Protection Act readiness checklist.
  DPA_CHECKLIST
  /// A call booked with a pre-sales engineer.
  BOOKING
}

/// Someone on the public site who asked to be contacted, with their consent.
model Lead {
  id          String     @id @default(cuid())
  reference   String     @unique
  market      String
  source      LeadSource
  status      LeadStatus @default(NEW)
  name        String
  email       String
  phone       String?
  company     String?
  /// What they're after, in their words or Thapelo's summary.
  need        String
  /// The exact consent wording they agreed to, and when.
  consentText String
  consentAt   DateTime
  chatId      String?    @unique
  handledById String?
  handledAt   DateTime?
  purgeAfter  DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// The free tool that last brought them, e.g. "email-check" (Milestone 8).
  tool              String?
  /// The tracked link they came through, if any.
  campaign          String?
  campaignSource    String?
  campaignMedium    String?
  /// What the tool found or worked out, for staff and the follow-up emails.
  toolResult        Json?
  /// The follow-up email sequence (src/server/leads/follow-ups.ts), the
  /// next step to send and when. Stops when they buy or unsubscribe.
  followUp          String?
  followUpStep      Int       @default(0)
  followUpAt        DateTime?
  followUpStoppedAt DateTime?
  followUpStopped   String?
  /// For the unsubscribe link in follow-up emails.
  unsubscribeToken  String?   @unique

  chat     SalesChat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  touches  LeadTouch[]
  bookings PresalesBooking[]

  @@index([status, createdAt])
  @@index([purgeAfter])
  @@index([email])
  @@index([followUpAt])
}

/// Each time a lead came back: which source and tool, and which campaign.
model LeadTouch {
  id             String     @id @default(cuid())
  leadId         String
  source         LeadSource
  tool           String?
  campaign       String?
  campaignSource String?
  campaignMedium String?
  summary        String
  createdAt      DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ─── Pre-sales bookings (final build, Milestone 8) ───────────────────

/// A staff member who takes pre-sales calls, with their weekly hours.
model PresalesEngineer {
  id         String   @id @default(cuid())
  userId     String   @unique
  active     Boolean  @default(true)
  /// Their Teams or Meet link, put in the calendar invite. Optional.
  meetingUrl String?
  /// Weekly hours in timeZone: [{ day: 1 (Monday) to 7, from: "09:00", to: "12:00" }].
  hours      Json
  timeZone   String   @default("Africa/Gaborone")
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings PresalesBooking[]
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

/// A call a visitor booked with a pre-sales engineer.
model PresalesBooking {
  id              String        @id @default(cuid())
  reference       String        @unique
  engineerId      String
  market          String
  startsAt        DateTime
  endsAt          DateTime
  /// What the call is about, e.g. "thebe" or "email-check"; "general" otherwise.
  topic           String
  name            String
  email           String
  phone           String?
  company         String?
  notes           String
  leadId          String?
  status          BookingStatus @default(BOOKED)
  /// Hash of the visitor's cancel link.
  cancelTokenHash String        @unique
  cancelledAt     DateTime?
  cancelledBy     String?
  /// Raised each time the invite changes, as calendars expect.
  sequence        Int           @default(0)
  reminderSentAt  DateTime?
  createdAt       DateTime      @default(now())

  engineer PresalesEngineer @relation(fields: [engineerId], references: [id], onDelete: Restrict)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([engineerId, startsAt])
  @@index([status, startsAt])
}

/// A Data Protection Act readiness checklist someone filled in. The
/// summary downloads once they have an account; the link is the token.
model ReadinessCheck {
  id             String   @id @default(cuid())
  /// Random, in the visitor's link to their summary.
  token          String   @unique
  market         String
  answers        Json
  score          Int
  organisationId String?
  leadId         String?
  createdAt      DateTime @default(now())
  purgeAfter     DateTime

  @@index([purgeAfter])
}

// ─── Launch kits, campaigns and the newsletter (final build, Milestone 7) ─

/// Prepared when a product goes live: its public page, an insight
/// draft, a LinkedIn post and tracked links. Nothing in it reaches the
/// public until a website Publisher approves it.
model LaunchKit {
  id                   String    @id @default(cuid())
  productId            String    @unique
  /// The campaign tag on every link in the kit, e.g. "launch-m365-standard".
  campaign             String    @unique
  /// "Who it is for" on the product page.
  audience             String    @default("")
  /// Questions and answers for the product page: [{ question, answer }].
  faq                  Json      @default("[]")
  /// When a Publisher approved the product page; until then it isn't shown.
  pageApprovedAt       DateTime?
  pageApprovedById     String?
  /// The insight draft in the website editor (its id there).
  insightId            String?
  linkedinText         String    @default("")
  /// When a Publisher approved the LinkedIn post for staff to copy.
  linkedinApprovedAt   DateTime?
  linkedinApprovedById String?
  /// When the AI drafts were written, or why they couldn't be.
  draftedAt            DateTime?
  draftError           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum CampaignEventKind {
  VISIT
  LEAD
  QUOTE
  SIGN_UP
}

/// What a tracked link brought: a visit, then any lead, quote request or
/// sign-up from the same browser. Orders are counted through sign-ups.
model CampaignEvent {
  id        String            @id @default(cuid())
  campaign  String
  source    String?
  medium    String?
  kind      CampaignEventKind
  /// The lead or quote reference, or the organisation id for a sign-up.
  ref       String?
  createdAt DateTime          @default(now())

  @@index([campaign, kind])
}

enum NewsletterIssueStatus {
  DRAFT
  SENT
}

/// A monthly newsletter for one market, prepared from recent insights.
/// A website Publisher reads it and sends it.
model NewsletterIssue {
  id         String                @id @default(cuid())
  market     String
  /// The month it covers, e.g. "2026-09".
  month      String
  subject    String
  intro      String
  /// The insights in it, in order: [{ id, title, summary, url }].
  items      Json
  status     NewsletterIssueStatus @default(DRAFT)
  sentAt     DateTime?
  sentById   String?
  recipients Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([market, month])
}

// ─── Bringing clients over from Odoo (Milestone 9b) ─────────────────

/// Where a service runs. Anything but OURS is looked after by hand: a
/// suspension, unsuspension or cancellation in billing becomes a staff task.
enum HostLocation {
  OURS
  CONTABO
  SITEGROUND
  OTHER
}

/// What the console knows about a running service that the billing engine
/// has no field for. Made for every service brought over from Odoo.
model ServiceProfile {
  billingServiceId     String       @id
  organisationId       String
  /// The customer's own price from before, kept instead of the price book:
  /// the whole service per billing period, for legacyQuantity units. A
  /// change of users is priced pro rata from it. Null: price book.
  legacyRecurringMinor BigInt?
  legacyQuantity       Int?
  legacyCurrency       String?
  /// When staff mean to look at the price again. Nothing changes by itself.
  legacyReviewOn       DateTime?    @db.Date
  hostedAt             HostLocation @default(OURS)
  /// The server, account or panel it lives in.
  hostServer           String?
  hostNotes            String?
  /// The status last seen in billing, so each change makes one task.
  lastStatus           String?
  movedAt              DateTime?
  movedByName          String?
  /// Where it came from, e.g. "Odoo SUB/2026/0042".
  source               String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([hostedAt])
}

enum MigrationStatus {
  /// Uploaded; the dry-run report waits for an admin.
  REVIEW
  /// Approved; the import job picks it up.
  APPROVED
  IMPORTING
  IMPORTED
  /// Stopped part way; the error says why. Approving again carries on.
  FAILED
  /// Replaced by a newer upload before it was approved.
  DISCARDED
}

/// One upload of the Odoo exports. Nothing reaches customers or billing
/// until an admin approves the dry-run report, and welcome emails wait
/// for the cutover date an admin chooses.
model MigrationBatch {
  id               String          @id @default(cuid())
  status           MigrationStatus @default(REVIEW)
  /// The rows read from each file, as uploaded.
  source           Json
  /// Staff choices: Odoo product name to a product slug, or "legacy".
  mapping          Json            @default("{}")
  /// The dry-run report for source and mapping.
  report           Json
  reportHash       String
  uploadedById     String
  uploadedByName   String
  approvedHash     String?
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  error            String?
  /// The day welcome emails go out, from 08:00 Gaborone time. None until chosen.
  cutoverOn        DateTime?       @db.Date
  cutoverSetByName String?
  welcomeSentAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  records MigrationRecord[]

  @@index([status])
}

/// What the import made from each Odoo row. One per row ever, so a second
/// upload or a re-run never makes anything twice. A row with no targetId
/// was being written to billing when a run stopped.
model MigrationRecord {
  id             String    @id @default(cuid())
  batchId        String
  /// "customer", "person", "client", "service", "domain" or "invoice".
  kind           String
  /// The Odoo reference: external id, subscription line, domain or invoice number.
  sourceRef      String
  organisationId String?
  targetId       String?
  /// People only: when their welcome email was queued.
  welcomedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([kind, sourceRef])
  @@index([batchId, kind])
}

/// An address from the old website and where it goes now (Milestone 10).
/// Matched on the exact path, without a trailing slash or query.
model SiteRedirect {
  id          String    @id @default(cuid())
  fromPath    String    @unique
  toPath      String
  /// How often it was followed, so staff can see which old links still matter.
  hits        Int       @default(0)
  lastHitAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   String?
}

// ─── Strategy upgrade (docs/STRATEGY_ROLLOUT.md) ─────────────────────

/// A switch in Admin > Features. A feature is off until an Admin turns it
/// on: no row means off. The list of features is in src/server/features.
model FeatureSwitch {
  key         String   @id
  enabled     Boolean  @default(false)
  updatedById String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// A partner set up in Admin > Partners (Openprovider, the .bw registry,
/// later backup and security providers). Credentials and custom fields are
/// sealed with a key derived from TOTP_ENCRYPTION_KEY and never shown back.
model PartnerSetting {
  /// "openprovider", "bw-registry".
  key             String    @id
  /// Admins turn a partner on once its test connection works.
  enabled         Boolean   @default(false)
  /// Settings that aren't secret (endpoint, test mode, nameservers), as entered.
  settings        Json      @default("{}")
  /// Secret settings (passwords, keys), sealed JSON.
  secrets         String?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  updatedById     String?
  updatedAt       DateTime  @updatedAt
}

/// Single row (id "company"): Admin > Company. Used on invoices, quotes,
/// emails, the website footer and WHMCS. Empty fields fall back to the
/// values the platform had before (src/config/app.ts and the default market).
model CompanyProfile {
  id                 String   @id @default("company")
  legalName          String
  tradingName        String
  registrationNumber String
  /// One part per line, as on a letterhead.
  address            String
  phone              String?
  email              String
  website            String?
  /// Printed at the foot of every invoice and quote.
  invoiceFooter      String?
  /// e.g. "Payment is due within 7 days of the invoice date."
  paymentTerms       String?
  /// The terms printed on quotes.
  quoteTerms         String?
  /// PNG logos, light (for white paper) and dark (for navy).
  logoLight          Bytes?
  logoDark           Bytes?
  updatedById        String?
  updatedAt          DateTime @updatedAt
}

/// Bank details for EFT, per market and currency (Admin > Company > Banking).
/// The market's own currency row is kept the same as the market settings.
model BankAccount {
  id            String   @id @default(cuid())
  marketCode    String
  currency      String
  bankName      String
  branchName    String?
  accountName   String
  accountNumber String
  branchCode    String?
  swiftCode     String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([marketCode, currency])
}

enum DomainOperationKind {
  REGISTER
  TRANSFER
  RENEW
}

enum DomainOperationStatus {
  /// Waiting for the order's invoice to be paid.
  WAITING_PAYMENT
  /// Paid; sent to the registrar and waiting for it to confirm.
  SUBMITTED
  DONE
  /// Gave up; a staff task carries it on.
  FAILED
  CANCELLED
}

/// A domain registration, transfer or renewal carried out automatically
/// once it is paid, through the registrar for its ending (Openprovider,
/// or the .bw registry once switched on).
model DomainOperation {
  id               String                @id @default(cuid())
  organisationId   String
  orderId          String?
  kind             DomainOperationKind
  domain           String
  years            Int
  /// "openprovider" or "bw-registry".
  registrar        String
  billingOrderId   String?
  billingInvoiceId String?
  billingDomainId  String?
  status           DomainOperationStatus @default(WAITING_PAYMENT)
  /// Transfers only: the code from the current registrar, sealed, cleared once used.
  authCodeSealed   String?
  /// Renewals: the expiry date before, to see the registrar moved it.
  previousExpiry   DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  attempts         Int                   @default(0)
  lastError        String?
  taskId           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([organisationId])
}

/// Invoices the console has emailed, so each is emailed once.
model InvoiceEmail {
  invoiceId      String   @id
  organisationId String
  sentAt         DateTime @default(now())
}

enum BackupHealth {
  /// Ordered; being set up.
  PENDING
  OK
  /// The last backup had problems but some data was saved.
  WARNING
  FAILED
}

/// A customer's off-site backup, delivered by the white-label backup
/// provider set up in Admin > Partners (STRATEGY_ROLLOUT U3). One per
/// backup service on the customer's account. The provider's name is never
/// shown to customers.
model BackupProtection {
  id               String       @id @default(cuid())
  organisationId   String
  /// The backup service in the billing engine.
  billingServiceId String
  /// What is protected, in the customer's words, e.g. "Microsoft 365 mailboxes".
  label            String
  health           BackupHealth @default(PENDING)
  lastSuccessAt    DateTime?
  lastAttemptAt    DateTime?
  retentionDays    Int?
  /// How much is protected, in plain words, e.g. "12 mailboxes, 84 GB".
  coverage         String?
  /// The provider's own reference for this backup; staff only.
  providerRef      String?
  /// Staff notes, never shown to the customer.
  notes            String?
  updatedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  restores     BackupRestoreRequest[]

  @@unique([organisationId, billingServiceId])
  @@index([health])
}

enum RestoreStatus {
  REQUESTED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// A customer's request to restore something from a backup. Carried out by
/// the provider's API when it has one, otherwise as a staff task.
model BackupRestoreRequest {
  id             String        @id @default(cuid())
  organisationId String
  protectionId   String
  /// What to restore, in the customer's words.
  what           String
  /// The day to restore from.
  fromDay        DateTime      @db.Date
  /// Where it goes back: "original" or "alongside".
  destination    String
  status         RestoreStatus @default(REQUESTED)
  requestedById  String
  taskId         String?
  providerRef    String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  protection   BackupProtection @relation(fields: [protectionId], references: [id], onDelete: Restrict)

  @@index([organisationId, status])
}

// ─── The security score (docs/STRATEGY_ROLLOUT.md, U4) ──────────────

/// An organisation's latest full security score, refreshed every night
/// while Admin > Features > "Full security score and monthly report" is on.
model SecurityProfile {
  organisationId String    @id
  /// The email domain checked; null means we pick one from the account.
  emailDomain    String?
  /// The last email security check (src/server/tools/email-check.ts).
  emailReport    Json?
  emailCheckedAt DateTime?
  score          Int?
  /// Every check, as shown on the score page.
  checks         Json?
  scoredAt       DateTime?
  /// Where the first email report came from, e.g. "email-check:L-7K2M" (U9).
  startedFrom    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([score])
}

/// The monthly security report: the score and checks as they stood on the
/// first of the month, in the console and emailed as a branded PDF.
model SecurityReport {
  id             String    @id @default(cuid())
  organisationId String
  /// "2026-10": the month the report covers.
  month          String
  score          Int
  checks         Json
  emailDomain    String?
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, month])
}

// ─── Managed security and the SOC (docs/STRATEGY_ROLLOUT.md, U5) ────

enum SecurityProviderType {
  MANUAL
  WEBHOOK
}

/// A security provider set up in Admin > Partners > Security provider.
/// Several can be stored; one is active. White-label: customers never see it.
model SecurityProvider {
  id              String               @id @default(cuid())
  type            SecurityProviderType @default(MANUAL)
  name            String
  endpoint        String?
  /// Tenant settings and custom fields, name to value.
  settings        Json                 @default("{}")
  /// API key, API secret and webhook secret, sealed (src/server/partners/vault.ts).
  secrets         String               @default("")
  active          Boolean              @default(false)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenants   SecurityTenant[]
  incidents SecurityIncident[]
  webhooks  SecurityWebhookEvent[]
}

enum SecurityTenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

/// A customer's tenant at the security provider.
model SecurityTenant {
  id             String               @id @default(cuid())
  organisationId String               @unique
  providerId     String
  /// The provider's own reference; staff only.
  tenantRef      String?
  status         SecurityTenantStatus @default(PENDING)
  /// Where the customer downloads the agent or enrols devices.
  enrolmentLink  String?
  enrolmentNote  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  provider     SecurityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  devices      SecurityDevice[]
}

enum DeviceHealth {
  HEALTHY
  AT_RISK
  OFFLINE
  UNPROTECTED
}

model SecurityDevice {
  id             String       @id @default(cuid())
  organisationId String
  tenantId       String
  /// The provider's device id, or one staff made up when entered by hand.
  providerRef    String
  name           String
  os             String?
  health         DeviceHealth @default(HEALTHY)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenant       SecurityTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, providerRef])
  @@index([organisationId])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  INVESTIGATING
  CONTAINED
  RESOLVED
}

/// An alert or incident from the provider, or entered by staff.
model SecurityIncident {
  id              String           @id @default(cuid())
  reference       String           @unique
  organisationId  String
  providerId      String?
  /// The provider's own id, so the same alert is never taken twice.
  providerRef     String?
  title           String
  /// What happened, in plain words the customer reads.
  summary         String
  severity        IncidentSeverity
  status          IncidentStatus   @default(NEW)
  /// What we are doing about it, as the customer reads it.
  ourAction       String?
  deviceName      String?
  assigneeId      String?
  /// When our first response is due, from the severity's target.
  respondBy       DateTime
  firstResponseAt DateTime?
  escalationLevel Int              @default(0)
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  provider     SecurityProvider?       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  assignee     User?                   @relation("incidentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events       SecurityIncidentEvent[]

  @@unique([providerId, providerRef])
  @@index([status, respondBy])
  @@index([organisationId])
}

/// The incident's timeline. Only events marked visible are shown to the customer.
model SecurityIncidentEvent {
  id                String   @id @default(cuid())
  incidentId        String
  organisationId    String
  /// "opened", "status", "action", "note", "assigned", "escalated", "notified".
  kind              String
  body              String
  visibleToCustomer Boolean  @default(false)
  actorLabel        String
  createdAt         DateTime @default(now())

  incident SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
}

/// The provider's monthly report for a customer, fetched or entered by staff.
model SocReport {
  id             String   @id @default(cuid())
  organisationId String
  /// "2026-10".
  month          String
  title          String
  summary        String?
  /// A link to the full report, if the provider gives one.
  url            String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, month])
}

/// Webhook deliveries already taken, so a replay is refused.
model SecurityWebhookEvent {
  id         String   @id
  providerId String
  receivedAt DateTime @default(now())

  provider SecurityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([receivedAt])
}

/// SOC response targets and escalation, set by Admins at /admin/soc.
model SocSettings {
  id              String   @id @default("global")
  criticalMinutes Int      @default(15)
  highMinutes     Int      @default(60)
  mediumMinutes   Int      @default(240)
  lowMinutes      Int      @default(1440)
  /// Who is emailed when an incident misses its target.
  escalationEmail String?
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

// ─── STRATEGY_ROLLOUT U7: the business structure ─────────────────────

enum BusinessUnit {
  SALES
  DELIVERY
  SUPPORT
  OPERATIONS
  PARTNERSHIPS
  FINANCE
  MARKETING
  PRODUCT
}

/// Which unit works each queue (leads, setup tasks, tickets...). Missing rows use the defaults in src/server/units/units.ts.
model UnitRoute {
  queue       String       @id
  unit        BusinessUnit
  updatedById String?
  updatedAt   DateTime     @updatedAt
}

/// Response targets per unit and priority, in minutes.
model UnitTarget {
  unit                 BusinessUnit
  priority             TicketPriority
  firstResponseMinutes Int
  resolveMinutes       Int
  updatedById          String?
  updatedAt            DateTime       @updatedAt

  @@id([unit, priority])
}

/// A month's measured response times, published on the Support pages once there is enough data.
model ResponseReport {
  /// "2026-10".
  month     String   @id
  /// Per unit and priority: counts, medians and share within target; satisfaction.
  data      Json
  tickets   Int
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PartnerStatus {
  PROSPECT
  ACTIVE
  PAUSED
  ENDED
}

/// The partner register: who we depend on, under which agreement, until when.
model PartnerRecord {
  id           String        @id @default(cuid())
  name         String
  /// e.g. "Distributor", "Security provider", "Registrar".
  category     String
  status       PartnerStatus @default(ACTIVE)
  /// People to call, one per line.
  contacts     String?
  agreementRef String?
  agreementUrl String?
  startsOn     DateTime?
  renewsOn     DateTime?
  /// Days of notice the agreement needs; the reminder goes out before that.
  noticeDays   Int           @default(60)
  /// Catalogue product slugs that depend on this partner.
  products     String[]      @default([])
  notes        String?
  /// The renewal date the last reminder was sent for.
  remindedFor  DateTime?
  updatedById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// The success dashboard's figures for a month (STRATEGY_ROLLOUT U8), refreshed
/// every night; the month's last refresh is its month-end figure.
model SuccessSnapshot {
  /// "2026-10".
  month      String    @id
  /// Customers, revenue by pillar, leads, response times and the security score.
  data       Json
  takenAt    DateTime
  /// When the month's email went to the directors.
  reportedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Targets for each figure and who gets the monthly email (Admin > Success).
model SuccessSettings {
  id             String   @id @default("success")
  directorEmails String[] @default([])
  /// Figure key to target, e.g. { "managedCustomers": 40 }.
  targets        Json     @default("{}")
  updatedById    String?
  updatedAt      DateTime @updatedAt
}

/// A free tool's result the visitor chose to share with a link (U9).
model SharedResult {
  /// The secret in the link.
  token       String    @id
  /// "email-check".
  tool        String
  /// What the result is about, e.g. the domain.
  subject     String
  result      Json
  consentText String
  consentAt   DateTime
  expiresAt   DateTime
  views       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

enum ReferralPartnerKind {
  ACCOUNTANT
  CONSULTANT
  IT_RESELLER
  OTHER
}

enum ReferralPartnerStatus {
  APPLIED
  ACTIVE
  PAUSED
  DECLINED
}

/// Accountants, consultants and IT resellers who send us customers (U9).
model ReferralPartner {
  id             String                @id @default(cuid())
  /// In their referral link, e.g. "kgosi-accounting".
  code           String?               @unique
  name           String
  company        String
  email          String
  phone          String?
  kind           ReferralPartnerKind
  market         String
  status         ReferralPartnerStatus @default(APPLIED)
  /// Their own commission in basis points; null uses the default in settings.
  commissionBps  Int?
  /// The secret in their dashboard link.
  dashboardToken String?               @unique
  /// Where we pay them, sealed like partner secrets.
  payoutDetails  String?
  consentText    String
  consentAt      DateTime
  notes          String?
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  referrals  Referral[]
  statements ReferralStatement[]

  @@index([status])
}

/// A customer who signed up through a referral partner's link.
model Referral {
  id             String          @id @default(cuid())
  partnerId      String
  organisationId String          @unique
  createdAt      DateTime        @default(now())

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
}

enum ReferralStatementStatus {
  /// Nothing earned that month.
  NIL
  DUE
  PAID
}

/// A partner's commission for a month: what their customers paid us, and their share.
model ReferralStatement {
  id              String                  @id @default(cuid())
  partnerId       String
  /// "2026-10".
  month           String
  currency        String
  paidInMinor     BigInt
  rateBps         Int
  commissionMinor BigInt
  /// Per customer: name and amount.
  lines           Json
  status          ReferralStatementStatus
  paidAt          DateTime?
  paidById        String?
  paymentRef      String?
  createdAt       DateTime                @default(now())

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([partnerId, month])
}

/// The default commission (Admin > Referral partners).
model ReferralSettings {
  id            String   @id @default("referrals")
  commissionBps Int      @default(1000)
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

enum ThebeAccountStatus {
  /// Waiting for the Thebe organisation: automatic or a staff task.
  PENDING
  ACTIVE
  /// Thebe's API refused; the setup task carries the reason.
  FAILED
}

/// A customer's Thebe organisation, made when they subscribe to a Thebe plan (U10).
model ThebeAccount {
  id             String             @id @default(cuid())
  organisationId String             @unique
  /// "thebe-founders", "thebe-team" or "thebe-organisation".
  plan           String
  users          Int                @default(1)
  orderId        String?
  /// The setup task that is the manual fallback.
  taskId         String?
  status         ThebeAccountStatus @default(PENDING)
  /// Thebe's id for the organisation, and where the customer signs in.
  thebeId        String?
  url            String?
  attempts       Int                @default(0)
  error          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
}

/// The named person at Fourth Generation Technologies who looks after a customer, shown on their home page (U11).
model AccountContact {
  organisationId String   @id
  userId         String
  assignedById   String?
  assignedAt     DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation("accountContact", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

/// What customers see about a colleague who is their account contact. Each colleague keeps their own (U11).
model StaffContactCard {
  userId    String   @id
  jobTitle  String?
  phone     String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A new customer's first-week checklist on their home page, once hidden by them (U11).
model WelcomeChecklist {
  organisationId String    @id
  dismissedAt    DateTime?
  dismissedById  String?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
}

/// The licence to sell connectivity in a market (U12). Connectivity can't be switched on, or offered in a market, until it is recorded here.
model ConnectivityLicence {
  market      String   @id
  /// Who granted it, such as BOCRA.
  regulator   String
  reference   String
  grantedOn   DateTime @db.Date
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  marketRow Market @relation(fields: [market], references: [code], onDelete: Restrict)
}

/// What a connectivity quote request asks for, beside the quote's own words (U12).
model ConnectivityRequest {
  id        String    @id @default(cuid())
  quoteId   String    @unique
  /// [{ "place": "Gaborone", "address": "Plot 64518, Fairgrounds" }]
  sites     Json
  speed     String
  standby   Boolean   @default(false)
  cloudLink Boolean   @default(false)
  managed   Boolean   @default(false)
  startBy   DateTime? @db.Date
  createdAt DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}
