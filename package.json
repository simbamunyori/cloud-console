{
  "name": "cloud-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-brand.mjs",
    "prebuild": "node scripts/copy-brand.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy && payload migrate",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "copy-check": "tsx scripts/check-copy.ts",
    "check": "npm run lint && npm run typecheck && npm run copy-check && npm test",
    "screenshots:hero": "tsx scripts/hero-screenshots.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test:a11y": "playwright test",
    "test:whmcs": "vitest run tests/whmcs.integration.test.ts",
    "test:whmcs-addon": "php whmcs/tests/run.php",
    "whmcs:sync": "tsx --conditions=react-server scripts/whmcs-sync.ts",
    "payload": "payload",
    "cms:generate": "payload generate:importmap && payload generate:types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "^1.48.0",
    "maxmind": "^5.0.7",
    "next": "16.3.7",
    "nodemailer": "^10.0.10",
    "payload": "3.90.2",
    "pg-boss": "^10.1.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright-core": "1.56.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "undici": "^7.30.0"
  }
}
