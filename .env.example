# Copy to .env and fill in. Never commit .env.
# Secrets are marked SECRET: they are read only through
# src/server/secrets.ts, so a vault can replace this file later.

# ─── Where the console runs ──────────────────────────────────────────
# Public address, used in email links. The domain is not decided yet.
APP_URL=http://localhost:3000
# What customers see the console called. Not decided yet.
CONSOLE_NAME=Cloud Console

# PostgreSQL. With docker-compose.yml for development:
DATABASE_URL=postgresql://console:console@localhost:5432/console
# Production (docker-compose.prod.yml) builds DATABASE_URL from this:
POSTGRES_PASSWORD=change-me
DOMAIN=localhost

# SECRET. Encrypts each person's authenticator secret. Exactly 32 random
# bytes, base64 encoded:  openssl rand -base64 32
# If it is lost, everyone must set up their authenticator again.
TOTP_ENCRYPTION_KEY=

# ─── Email ───────────────────────────────────────────────────────────
# Development: Mailpit from docker-compose.yml; read mail at http://localhost:8025
# Production: smtps://user:password@smtp.example.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Fourth Generation Technologies <no-reply@localhost>"

# ─── Billing engine ──────────────────────────────────────────────────
# "stub" runs the stand-in with sample data (development, CI, demos).
# "whmcs" talks to WHMCS; docs/whmcs-setup.md says how to prepare it.
BILLING_ADAPTER=stub
# WHMCS_API_URL=https://billing.fourthgeneration.technology/includes/api.php
# SECRET. The API credential from Configuration > System Settings > Manage API Credentials.
# WHMCS_API_IDENTIFIER=
# WHMCS_API_SECRET=
# SECRET. Only when WHMCS uses an access key instead of an IP allowlist.
# WHMCS_ACCESS_KEY=
# SECRET. Shared with the price sync addon in WHMCS.
# WHMCS_SYNC_SECRET=
# "test" or "production". The WHMCS write tests refuse to run on production.
# WHMCS_ENVIRONMENT=test

# ─── Microsoft 365 and Google Workspace ──────────────────────────────
# Who carries out licence and user changes in customers' tenants.
# "stub" applies them at once to demo data (development, CI, demos).
# "manual" hands each one to staff as a task until the vendor APIs are connected.
TENANT_PROVIDER=stub

# ─── Payments ────────────────────────────────────────────────────────
# The card gateway is not chosen yet; "stub" simulates one.
PAYMENT_ADAPTER=stub
# Bank details for EFT, support contacts and tax are set per market by
# staff at /admin/markets, not here.

# ─── Support assistant ───────────────────────────────────────────────
# SECRET. Without it, the assistant says it isn't switched on and offers a ticket.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# The same key runs Thapelo, the website's sales assistant. Demo and CI
# servers only: yes gives Thapelo scripted answers without an AI bill.
# A production server refuses to start with it.
# SALES_ASSISTANT_DEMO=yes

# ─── Visitor country ─────────────────────────────────────────────────
# Header the CDN adds with the visitor's country. Cloudflare sends
# cf-ipcountry (turn on "IP Geolocation" in Network settings).
GEO_COUNTRY_HEADER=cf-ipcountry
# Optional MaxMind GeoLite2 Country database, used when the header is
# missing. Download GeoLite2-Country.mmdb with a free MaxMind account.
# GEOLITE2_DB_PATH=/data/GeoLite2-Country.mmdb

# ─── Staff console ───────────────────────────────────────────────────
# Comma-separated addresses or IPv4 ranges allowed to open /admin, e.g.
# the VPN range. Empty allows any address (fine for development only).
ADMIN_IP_ALLOWLIST=

# ─── Sign in with Microsoft and Google ───────────────────────────────
# docs/sign-in-setup.md. Each button hides while its id or secret is unset.
# Passkeys need no setting. Staff sign in with Microsoft from our own
# tenant once MICROSOFT_STAFF_TENANT_ID is set, and then their passwords
# stop working unless STAFF_PASSWORD_SIGN_IN=yes.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_STAFF_TENANT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STAFF_PASSWORD_SIGN_IN=no

# ─── Public site ─────────────────────────────────────────────────────
# An outside service status page. While unset, status links go to the
# site's own /status page, run by staff at /admin/status.
# STATUS_PAGE_URL=https://status.example.com
# Thebe: trial page ("Try Thebe"), website ("Learn more about Thebe") and
# demo booking page. Optional: unset, the first two go to
# https://www.thebe.africa (Try Thebe is also editable in the site editor)
# and the demo goes to our pre-sales booking page.
# THEBE_TRY_URL=
# THEBE_URL=
# THEBE_DEMO_URL=
# NSMC's website, for the on-site IT line. Optional: https://www.nsmc.africa if unset.
# NSMC_URL=
# Demo and CI servers only: the email security check answers from fixed
# records instead of public DNS.
# TOOLS_DEMO=yes

# ─── Production safety ───────────────────────────────────────────────
# In production the server refuses to start while development placeholders
# are set: a support@localhost address, the demo bank details, seeded
# exchange rates, demo accounts, or a localhost APP_URL or MAIL_FROM.
# "yes" starts anyway with a warning. For demo and CI servers only.
# ALLOW_PLACEHOLDERS=yes

# Background jobs run inside the app. Set to "off" on extra servers.
# CONSOLE_JOBS=off

# ─── Website editor (Payload) ───────────────────────────────────────
# SECRET. Payload signs its own tokens with it (staff sign in with their
# console session, so there are no editor passwords). 32+ random bytes:
#   openssl rand -base64 32
PAYLOAD_SECRET=
# Where uploaded images are kept: "disk" (MEDIA_DIR) is the only storage
# for now; object storage can be added behind src/cms/storage later.
# MEDIA_STORAGE=disk
# In docker-compose.prod.yml this is a volume the nightly backup copies.
# MEDIA_DIR=/app/media

# ─── Nightly backup (docker-compose.prod.yml) ───────────────────────
# SECRET. Encrypts each backup; keep a copy somewhere other than the server,
# or the backups can't be restored.
BACKUP_PASSPHRASE=
# BACKUP_AT=23:00        # UTC, so 01:00 in Botswana
# BACKUP_KEEP_DAYS=30
# Off-site copies of each backup: Cloudflare R2, Contabo Object Storage
# (provider Other) or any S3-compatible storage. Without an access key,
# backups stay on the server only.
# OFFSITE_S3_PROVIDER=Cloudflare
# OFFSITE_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# OFFSITE_S3_BUCKET=fgt-console-backups
# SECRET.
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=

# ─── Production set-up (docs/deploy.md) ─────────────────────────────
# Filled into every market still on support@localhost when a release starts.
# SUPPORT_EMAIL=support@fourthgeneration.technology
